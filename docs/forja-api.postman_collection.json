{
  "info": {
    "_postman_id": "05bf4cf5-72c2-4cdc-a8e0-fdd7f8fc37b2",
    "name": "Forja Athletics API - Productos",
    "description": "API RESTful de productos de Forja Athletics (Node.js + Express + MySQL) desplegada en Oracle Cloud Infrastructure.\n\nEjecutar en orden: el POST guarda el id creado en la variable producto_nuevo_id, que usan el PUT y el DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Endpoints",
      "item": [
        {
          "name": "1. GET - Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "Obtiene la lista completa de productos. Éxito: 200 OK."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. GET - Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos",
                "{{producto_id}}"
              ]
            },
            "description": "Obtiene un producto por su id. Éxito: 200 OK. Error: 404 Not Found."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. POST - Crear producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "Crea un producto. Éxito: 201 Created. Error: 400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Playera Pump Cover\",\n  \"descripcion\": \"Playera oversize de algodón para entrenamiento\",\n  \"genero\": \"unisex\",\n  \"precio_base\": 449.0,\n  \"categoria_id\": 1,\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set(\"producto_nuevo_id\", json.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "4. PUT - Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/productos/{{producto_nuevo_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos",
                "{{producto_nuevo_id}}"
              ]
            },
            "description": "Actualiza un producto existente. Éxito: 200 OK. Errores: 400 / 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Playera Pump Cover Pro\",\n  \"descripcion\": \"Playera oversize de algodón pesado, edición Pro\",\n  \"genero\": \"hombre\",\n  \"precio_base\": 499.0,\n  \"categoria_id\": 1,\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. DELETE - Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/{{producto_nuevo_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos",
                "{{producto_nuevo_id}}"
              ]
            },
            "description": "Elimina un producto. Éxito: 200 OK. Error: 404 Not Found (409 si tiene ventas)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ]
    },
